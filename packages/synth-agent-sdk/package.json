{
  "name": "@synth-framework/agent-sdk",
  "version": "2.4.1",
  "description": "Language-agnostic SDK for AI agent interoperability with SYNTH.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./protocol": {
      "import": "./dist/protocol.js",
      "types": "./dist/protocol.d.ts"
    },
    "./metadata": {
      "import": "./dist/metadata.js",
      "types": "./dist/metadata.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "synth",
    "ai-agent",
    "interoperability",
    "genesis-protocol",
    "governance",
    "deterministic-execution"
  ],
  "homepage": "https://synth-framework.github.io/synth",
  "repository": {
    "type": "git",
    "url": "https://github.com/synth-framework/synth.git",
    "directory": "packages/synth-agent-sdk"
  },
  "bugs": {
    "url": "https://github.com/synth-framework/synth/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
