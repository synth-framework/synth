diff --git a/tests/ledger-ceremony.test.js b/tests/ledger-ceremony.test.js
new file mode 100644
index 0000000..d222336
--- /dev/null
+++ b/tests/ledger-ceremony.test.js
@@ -0,0 +1,106 @@
+// ============================================================
+// LEDGER CEREMONY COMMITS (ADR-055 rev 2 §R2.1)
+// ============================================================
+// Every ceremony that mutates governance state ends in exactly one commit on
+// the ledger branch, made by the Ledger Writer, with the normative message
+//   chore(synth): <TRANSITION> <entity-kind> <entity-id8>
+// A refusal is returned with its `LEDGER_*` code (never thrown, never silent).
+// ============================================================
+
+import { strict as assert } from "assert"
+import { execFileSync } from "child_process"
+import fs from "fs"
+import path from "path"
+import test from "node:test"
+import { CEREMONIES, ceremonyMessage, commitCeremony } from "../dist/ledger/ceremony.js"
+import { makeTempDirSync } from "./helpers/workspace.js"
+
+function git(root, args) {
+  return execFileSync("git", args, { cwd: root, encoding: "utf-8" }).trim()
+}
+
+function makeLedgerRepo(prefix = "synth-ceremony-") {
+  const root = makeTempDirSync(prefix)
+  fs.mkdirSync(path.join(root, ".synth", "data", "event-stream", "partition-0"), { recursive: true })
+  fs.mkdirSync(path.join(root, "proof", "expeditions"), { recursive: true })
+  fs.mkdirSync(path.join(root, "src"), { recursive: true })
+  fs.writeFileSync(path.join(root, ".synth", "data", "canonical-state.json"), JSON.stringify({ version: 1 }) + "\n")
+  fs.writeFileSync(path.join(root, "proof", "expeditions", ".gitkeep"), "")
+  fs.writeFileSync(path.join(root, "src", "main.ts"), "export const main = () => 1\n")
+  fs.writeFileSync(path.join(root, ".gitignore"), [".synth/anchor/", ".synth/worktrees/", "dist/"].join("\n") + "\n")
+  execFileSync("git", ["init", "-b", "main", root], { stdio: "pipe" })
+  git(root, ["config", "user.email", "ceremony@test"])
+  git(root, ["config", "user.name", "Ceremony Test"])
+  git(root, ["add", "-A"])
+  git(root, ["commit", "-m", "fixture"])
+  return root
+}
+
+async function withRepo(fn) {
+  const root = makeLedgerRepo()
+  try {
+    return await fn(root)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+}
+
+const EXPEDITION_ID = "bda2bbd4ef6550af"
+
+test("ledger ceremony: the transition table and message shape follow §R2.1", () => {
+  assert.equal(ceremonyMessage(CEREMONIES["expedition-start"], EXPEDITION_ID), `chore(synth): EXPEDITION_STARTED expedition bda2bbd4`)
+  assert.equal(ceremonyMessage(CEREMONIES["expedition-complete"], EXPEDITION_ID), "chore(synth): EXPEDITION_COMPLETED expedition bda2bbd4")
+  assert.equal(ceremonyMessage(CEREMONIES["expedition-finish"], EXPEDITION_ID), "chore(synth): EXPEDITION_FINISHED expedition bda2bbd4")
+  assert.equal(ceremonyMessage(CEREMONIES["evidence-attach"], EXPEDITION_ID), "chore(synth): EVIDENCE_ATTACHED expedition bda2bbd4")
+  assert.equal(ceremonyMessage(CEREMONIES["expedition-refine"], EXPEDITION_ID), "chore(synth): EXPEDITION_REFINED expedition bda2bbd4")
+  assert.equal(
+    ceremonyMessage(CEREMONIES["convergence-certification"], EXPEDITION_ID),
+    "chore(synth): CONVERGENCE_CERTIFIED expedition bda2bbd4",
+  )
+  // A ceremony missing from the table still produces a well-formed message.
+  assert.equal(ceremonyMessage({ transition: "MISSION_APPROVED", entityKind: "mission" }, "a57585f0aec4b2d8"), "chore(synth): MISSION_APPROVED mission a57585f0")
+})
+
+test("ledger ceremony: commitCeremony lands one commit on the ledger branch and leaves the tree clean", async () => {
+  await withRepo(async (root) => {
+    const before = git(root, ["rev-parse", "main"])
+    fs.writeFileSync(path.join(root, ".synth", "data", "canonical-state.json"), JSON.stringify({ version: 2 }) + "\n")
+
+    const ceremony = await commitCeremony(root, "expedition-start", EXPEDITION_ID)
+
+    assert.equal(ceremony.committed, true, JSON.stringify(ceremony))
+    assert.equal(ceremony.message, "chore(synth): EXPEDITION_STARTED expedition bda2bbd4")
+    assert.deepEqual(ceremony.files, [".synth/data/canonical-state.json"])
+    assert.equal(git(root, ["rev-parse", "main"]), ceremony.commitHash)
+    assert.notEqual(ceremony.commitHash, before)
+    assert.equal(git(root, ["log", "-1", "--format=%s"]), ceremony.message)
+    assert.equal(git(root, ["status", "--porcelain"]), "", "the ceremony leaves the ledger clean")
+  })
+})
+
+test("ledger ceremony: a clean ledger reports no changes without a code", async () => {
+  await withRepo(async (root) => {
+    const head = git(root, ["rev-parse", "HEAD"])
+
+    const ceremony = await commitCeremony(root, "expedition-complete", EXPEDITION_ID)
+
+    assert.equal(ceremony.committed, false)
+    assert.equal(ceremony.code, undefined, "no changes is not a writer refusal")
+    assert.match(ceremony.reason, /no ledger changes/)
+    assert.equal(git(root, ["rev-parse", "HEAD"]), head, "nothing is committed")
+  })
+})
+
+test("ledger ceremony: a detached HEAD is a loud LEDGER_UNAVAILABLE refusal", async () => {
+  await withRepo(async (root) => {
+    git(root, ["checkout", "--detach"])
+    fs.writeFileSync(path.join(root, ".synth", "data", "canonical-state.json"), JSON.stringify({ version: 3 }) + "\n")
+
+    const ceremony = await commitCeremony(root, "expedition-refine", EXPEDITION_ID)
+
+    assert.equal(ceremony.committed, false)
+    assert.equal(ceremony.code, "LEDGER_UNAVAILABLE")
+    assert.match(ceremony.reason, /Detached HEAD/)
+    assert.ok(ceremony.nextStep, "a refusal must carry a next step")
+  })
+})
diff --git a/tests/ledger-doctor.test.js b/tests/ledger-doctor.test.js
new file mode 100644
index 0000000..225b34f
--- /dev/null
+++ b/tests/ledger-doctor.test.js
@@ -0,0 +1,173 @@
+// ============================================================
+// LEDGER DOCTOR (ADR-055 §2.10, AC6 / AC8 / AC13)
+// ============================================================
+// The four silent-failure classes of the ceremony ledger, each against a real
+// temporary repository:
+//   1. an uncommitted ceremony         → committed by `doctor --fix` as ONE commit
+//   2. a prunable anchor               → pruned and recreated
+//   3. the anchor behind the branch    → re-pointed at the branch tip
+//   4. a detached checkout             → reported; repair refuses
+// Plus the read-only contract: `checkLedger` never writes.
+// ============================================================
+
+import { strict as assert } from "assert"
+import { execFileSync } from "child_process"
+import fs from "fs"
+import path from "path"
+import test from "node:test"
+import { checkLedger, dirtyLedgerPaths, ledgerBranch, repairLedger } from "../dist/ledger/doctor.js"
+import { anchorPath, ensureAnchor, readAnchorState } from "../dist/ledger/writer.js"
+import { makeTempDirSync } from "./helpers/workspace.js"
+
+function git(root, args) {
+  return execFileSync("git", args, { cwd: root, encoding: "utf-8" }).trim()
+}
+
+function writeLedgerFixture(root) {
+  fs.mkdirSync(path.join(root, ".synth", "data", "event-stream", "partition-0"), { recursive: true })
+  fs.mkdirSync(path.join(root, "proof", "expeditions"), { recursive: true })
+  fs.mkdirSync(path.join(root, "src"), { recursive: true })
+  fs.writeFileSync(path.join(root, ".synth", "data", "canonical-state.json"), JSON.stringify({ version: 1 }) + "\n")
+  fs.writeFileSync(path.join(root, ".synth", "data", "event-stream", "partition-0", "segment-0001.jsonl"), "")
+  fs.writeFileSync(path.join(root, "proof", "expeditions", ".gitkeep"), "")
+  fs.writeFileSync(path.join(root, "src", "main.ts"), "export const main = () => 1\n")
+  fs.writeFileSync(
+    path.join(root, ".gitignore"),
+    [".synth/anchor/", ".synth/worktrees/", ".synth/cache/", "dist/"].join("\n") + "\n",
+  )
+}
+
+function makeLedgerRepo(prefix = "synth-doctor-") {
+  const root = makeTempDirSync(prefix)
+  writeLedgerFixture(root)
+  execFileSync("git", ["init", "-b", "main", root], { stdio: "pipe" })
+  git(root, ["config", "user.email", "doctor@test"])
+  git(root, ["config", "user.name", "Doctor Test"])
+  git(root, ["add", "-A"])
+  git(root, ["commit", "-m", "fixture"])
+  return root
+}
+
+async function withRepo(fn) {
+  const root = makeLedgerRepo()
+  try {
+    return await fn(root)
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+}
+
+test("ledger doctor: a healthy ledger passes every check, and checking writes nothing", async () => {
+  await withRepo(async (root) => {
+    await ensureAnchor(root, "main")
+    const headBefore = git(root, ["rev-parse", "HEAD"])
+
+    const health = await checkLedger(root)
+
+    assert.equal(health.repo, true)
+    assert.equal(health.branch, "main")
+    assert.equal(health.anchor.ok, true)
+    assert.equal(health.ceremony.ok, true)
+    assert.equal(health.sync.ok, true)
+    assert.equal(git(root, ["rev-parse", "HEAD"]), headBefore, "checkLedger must not commit")
+    assert.equal(git(root, ["status", "--porcelain"]), "", "checkLedger must not write")
+  })
+})
+
+test("ledger doctor: an uncommitted ceremony is detected and repaired as one commit", async () => {
+  await withRepo(async (root) => {
+    fs.writeFileSync(path.join(root, ".synth", "data", "canonical-state.json"), JSON.stringify({ version: 2 }) + "\n")
+
+    const before = await checkLedger(root)
+    assert.equal(before.ceremony.ok, false, "an uncommitted ceremony must be visible")
+    assert.match(before.ceremony.detail, /canonical-state\.json/)
+    assert.ok(before.ceremony.nextStep)
+
+    const repair = await repairLedger(root)
+    assert.deepEqual(repair.errors, [])
+    assert.equal(repair.actions[0], "committed a stalled ceremony: 1 path(s) as " + repair.commit.commitHash.slice(0, 8))
+    assert.ok(repair.actions.some((a) => a.includes("recreated the anchor")), repair.actions.join(", "))
+    assert.deepEqual(repair.commit.files, [".synth/data/canonical-state.json"])
+    assert.equal(git(root, ["log", "-1", "--format=%s"]), "chore(synth): ledger repair (doctor --fix)")
+    assert.equal(git(root, ["status", "--porcelain"]), "", "the repair leaves a clean checkout")
+
+    const after = await checkLedger(root)
+    assert.equal(after.ceremony.ok, true)
+    assert.equal(after.sync.ok, true, "the anchor is reconciled with the new commit")
+  })
+})
+
+test("ledger doctor: a prunable anchor is detected and recreated", async () => {
+  await withRepo(async (root) => {
+    await ensureAnchor(root, "main")
+    fs.rmSync(anchorPath(root), { recursive: true, force: true })
+
+    const before = await checkLedger(root)
+    assert.equal(before.anchor.ok, false, "a deleted anchor directory must be reported")
+    assert.match(before.anchor.detail, /prunable/)
+
+    const repair = await repairLedger(root)
+    assert.deepEqual(repair.errors, [])
+    assert.equal(repair.anchor.created, true)
+    assert.equal((await readAnchorState(root)).present, true)
+
+    const after = await checkLedger(root)
+    assert.equal(after.anchor.ok, true)
+    assert.equal(after.sync.ok, true)
+  })
+})
+
+test("ledger doctor: an anchor behind the branch is re-pointed at the tip", async () => {
+  await withRepo(async (root) => {
+    await ensureAnchor(root, "main")
+    // A ceremony that bypassed the anchor: a direct ledger commit in the checkout.
+    fs.writeFileSync(path.join(root, ".synth", "data", "canonical-state.json"), JSON.stringify({ version: 3 }) + "\n")
+    git(root, ["add", ".synth/data/canonical-state.json"])
+    git(root, ["commit", "-m", "chore(synth): direct ledger commit"])
+
+    const before = await checkLedger(root)
+    assert.equal(before.sync.ok, false, "a stale anchor must be reported")
+    assert.match(before.sync.detail, /behind/)
+
+    const repair = await repairLedger(root)
+    assert.deepEqual(repair.errors, [])
+    assert.ok(repair.actions.some((a) => a.includes("re-pointed")), repair.actions.join(", "))
+    assert.equal((await readAnchorState(root)).commit, git(root, ["rev-parse", "main"]))
+
+    const after = await checkLedger(root)
+    assert.equal(after.sync.ok, true)
+  })
+})
+
+test("ledger doctor: a detached checkout is reported and the repair refuses", async () => {
+  await withRepo(async (root) => {
+    await ensureAnchor(root, "main")
+    git(root, ["checkout", "--detach"])
+
+    const health = await checkLedger(root)
+    assert.equal(health.branch, undefined)
+    assert.equal(health.sync.ok, false)
+    assert.match(health.sync.detail, /Detached HEAD/)
+    assert.equal(ledgerBranch(root), undefined)
+
+    const repair = await repairLedger(root)
+    assert.equal(repair.actions.length, 0)
+    assert.equal(repair.errors.length, 1)
+    assert.match(repair.errors[0], /Detached HEAD/)
+  })
+})
+
+test("ledger doctor: --fix on a healthy ledger is a no-op", async () => {
+  await withRepo(async (root) => {
+    await ensureAnchor(root, "main")
+    const head = git(root, ["rev-parse", "HEAD"])
+
+    const repair = await repairLedger(root)
+
+    assert.deepEqual(repair.actions, [])
+    assert.deepEqual(repair.errors, [])
+    assert.equal(repair.commit, undefined)
+    assert.equal(git(root, ["rev-parse", "HEAD"]), head)
+    assert.equal(dirtyLedgerPaths(root).length, 0)
+  })
+})
diff --git a/tests/ledger-writer.test.js b/tests/ledger-writer.test.js
new file mode 100644
index 0000000..9aab9ab
--- /dev/null
+++ b/tests/ledger-writer.test.js
@@ -0,0 +1,251 @@
+// ============================================================
+// LEDGER WRITER (ADR-055 §2.3 / §2.10)
+// ============================================================
+// The writer is the single path for governance commits:
+//   lock → anchor (detached, sparse) → commit → update-ref CAS.
+// These tests exercise the mechanics against real temporary repositories:
+// creation, sparse checkout, advancing the branch, the dirty-ledger refusal,
+// the compare-and-swap refusal, lock contention / stale-lock recovery, and
+// repair of a deleted anchor.
+// ============================================================
+
+import { strict as assert } from "assert"
+import { execFileSync } from "child_process"
+import fs from "fs"
+import path from "path"
+import test from "node:test"
+import {
+  LedgerError,
+  acquireLedgerLock,
+  advanceCanonicalBranch,
+  anchorPath,
+  ensureAnchor,
+  readAnchorState,
+  repairAnchor,
+} from "../dist/ledger/writer.js"
+import { makeTempDirSync } from "./helpers/workspace.js"
+
+function git(root, args) {
+  return execFileSync("git", args, { cwd: root, encoding: "utf-8" }).trim()
+}
+
+function writeLedgerFixture(root) {
+  fs.mkdirSync(path.join(root, ".synth", "data", "event-stream", "partition-0"), { recursive: true })
+  fs.mkdirSync(path.join(root, "proof", "expeditions"), { recursive: true })
+  fs.mkdirSync(path.join(root, "src"), { recursive: true })
+  fs.writeFileSync(path.join(root, ".synth", "data", "canonical-state.json"), JSON.stringify({ version: 1 }) + "\n")
+  fs.writeFileSync(path.join(root, ".synth", "data", "event-stream", "partition-0", "segment-0001.jsonl"), "")
+  fs.writeFileSync(path.join(root, "proof", "expeditions", ".gitkeep"), "")
+  fs.writeFileSync(path.join(root, "src", "main.ts"), "export const main = () => 1\n")
+  fs.writeFileSync(
+    path.join(root, ".gitignore"),
+    [".synth/anchor/", ".synth/worktrees/", ".synth/cache/", "dist/"].join("\n") + "\n",
+  )
+}
+
+function makeLedgerRepo(prefix = "synth-ledger-") {
+  const root = makeTempDirSync(prefix)
+  writeLedgerFixture(root)
+  execFileSync("git", ["init", "-b", "main", root], { stdio: "pipe" })
+  git(root, ["config", "user.email", "ledger@test"])
+  git(root, ["config", "user.name", "Ledger Test"])
+  git(root, ["add", "-A"])
+  git(root, ["commit", "-m", "fixture"])
+  return root
+}
+
+test("ledger writer: ensureAnchor creates a detached sparse anchor", async () => {
+  const root = makeLedgerRepo()
+  const result = await ensureAnchor(root, "main")
+
+  assert.equal(result.created, true)
+  assert.equal(result.path, anchorPath(root))
+  assert.equal(git(root, ["-C", ".synth/anchor", "rev-parse", "--abbrev-ref", "HEAD"]), "HEAD", "anchor must be detached")
+  assert.ok(fs.existsSync(path.join(root, ".synth", "anchor", ".synth")), "ledger paths are materialized")
+  assert.ok(fs.existsSync(path.join(root, ".synth", "anchor", "proof")), "proof is materialized")
+  assert.ok(!fs.existsSync(path.join(root, ".synth", "anchor", "src")), "source is sparse-excluded")
+
+  // The anchor is invisible to the operator's checkout.
+  assert.equal(git(root, ["status", "--porcelain"]), "", "anchor must not dirty the operator checkout")
+
+  const state = await readAnchorState(root)
+  assert.equal(state.present, true)
+  assert.equal(state.detached, true)
+  assert.deepEqual(state.dirtyPaths, [])
+
+  fs.rmSync(root, { recursive: true, force: true })
+})
+
+test("ledger writer: advanceCanonicalBranch commits in the anchor and moves the branch by CAS", async () => {
+  const root = makeLedgerRepo()
+  await ensureAnchor(root, "main")
+  const before = git(root, ["rev-parse", "main"])
+
+  fs.writeFileSync(
+    path.join(root, ".synth", "anchor", ".synth", "data", "canonical-state.json"),
+    JSON.stringify({ version: 2 }) + "\n",
+  )
+
+  const result = await advanceCanonicalBranch(root, {
+    branch: "main",
+    message: "chore(synth): EXPEDITION_STARTED bda2bbd4",
+  })
+
+  assert.equal(result.committed, true)
+  assert.notEqual(result.commitHash, before)
+  assert.deepEqual(result.files, [".synth/data/canonical-state.json"])
+
+  // The branch advanced, and the operator's checkout (which is on the branch)
+  // was refreshed for the ceremony's paths — it must not look locally modified.
+  assert.notEqual(result.commitHash, before)
+  assert.equal(git(root, ["rev-parse", "main"]), result.commitHash)
+  assert.equal(git(root, ["status", "--porcelain"]), "", "operator tree stays clean")
+  assert.equal(
+    fs.readFileSync(path.join(root, ".synth", "data", "canonical-state.json"), "utf-8"),
+    JSON.stringify({ version: 2 }) + "\n",
+    "operator working tree carries the committed ledger state",
+  )
+  assert.equal(
+    git(root, ["show", `${result.commitHash}:.synth/data/canonical-state.json`]),
+    JSON.stringify({ version: 2 }),
+    "the commit carries the ledger change",
+  )
+  assert.match(git(root, ["log", "-1", "--format=%s", result.commitHash]), /^chore\(synth\): EXPEDITION_STARTED/)
+
+  fs.rmSync(root, { recursive: true, force: true })
+})
