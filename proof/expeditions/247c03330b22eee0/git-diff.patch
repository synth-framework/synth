diff --git a/scratch-ts-morph/analyze.js b/scratch-ts-morph/analyze.js
new file mode 100644
index 0000000..bc0064e
--- /dev/null
+++ b/scratch-ts-morph/analyze.js
@@ -0,0 +1,81 @@
+const { Project, SyntaxKind } = require("ts-morph");
+const fs = require("fs");
+const path = require("path");
+
+const text = fs.readFileSync("../knip-audit-report.md", "utf8");
+const lines = text.split("\n");
+
+let inUnusedExports = false;
+const unusedExports = [];
+
+for (const line of lines) {
+  if (line.startsWith("Unused exports (")) {
+    inUnusedExports = true;
+    continue;
+  }
+  if (inUnusedExports) {
+    if (line.trim() === "" || line.startsWith("Unused ") || line.startsWith("Configuration hints")) break;
+    // line format: exportName   type   filePath:line:col
+    const match = line.trim().match(/^([\w\$]+)\s+(?:[\w]+\s+)?(src\/.*?\.ts):(\d+):\d+$/);
+    if (match) {
+        unusedExports.push({
+            name: match[1],
+            file: match[2]
+        });
+    }
+  }
+}
+
+console.log(`Parsed ${unusedExports.length} unused exports to analyze.`);
+
+const project = new Project({
+    tsConfigFilePath: "../tsconfig.json",
+});
+
+const stringLiterals = new Set();
+for (const sourceFile of project.getSourceFiles()) {
+    sourceFile.forEachDescendant(node => {
+        if (node.getKind() === SyntaxKind.StringLiteral || node.getKind() === SyntaxKind.NoSubstitutionTemplateLiteral) {
+            stringLiterals.add(node.getLiteralValue());
+        }
+    });
+}
+
+function readJsonStrings(dir) {
+    const files = fs.readdirSync(dir);
+    for (const file of files) {
+        const fullPath = path.join(dir, file);
+        if (fs.statSync(fullPath).isDirectory()) {
+            readJsonStrings(fullPath);
+        } else if (fullPath.endsWith('.json')) {
+            const content = fs.readFileSync(fullPath, 'utf8');
+            const matches = content.match(/"([^"]+)"/g);
+            if (matches) {
+                for (const m of matches) {
+                    stringLiterals.add(m.replace(/"/g, ''));
+                }
+            }
+        }
+    }
+}
+if (fs.existsSync("../data")) {
+    readJsonStrings("../data");
+}
+
+const results = {
+    trulyDead: [],
+    dynamicallyReferenced: []
+};
+
+for (const exp of unusedExports) {
+    if (stringLiterals.has(exp.name)) {
+        results.dynamicallyReferenced.push(exp);
+    } else {
+        results.trulyDead.push(exp);
+    }
+}
+
+fs.writeFileSync("ast-analysis-results.json", JSON.stringify(results, null, 2));
+console.log(`\nAnalysis complete!`);
+console.log(`- Truly Dead: ${results.trulyDead.length}`);
+console.log(`- Dynamically Referenced (Found in string literal/JSON): ${results.dynamicallyReferenced.length}`);
