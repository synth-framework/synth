#!/usr/bin/env bash
# ============================================================
# Repo-local synth CLI shim (EXP: local bin standardization)
# ============================================================
# Runs THIS repository's build of the synth CLI instead of any
# globally installed @synth-framework/synth. Contributors and repo
# automation should invoke `scripts/synth <command>` (or add
# `scripts/` to PATH) so the CLI always matches the working tree.
#
# This shim is repo-only: `scripts/` is excluded from the published
# npm `files`, so release installs continue to resolve the packaged
# `synth` bin (dist/cli/synth.js) via `npm install -g`.
#
# Usage:
#   scripts/synth <command> [options]      # e.g. scripts/synth status
#   SYNTH_SHIM_NO_BUILD=1 scripts/synth …   # skip the auto-build check
# ============================================================

set -euo pipefail

# Resolve the repository root from this script's location so the shim
# works regardless of the caller's current working directory.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CLI_ENTRY="${REPO_ROOT}/dist/cli/synth.js"

# Build on demand when the compiled entrypoint is missing, unless the
# caller opted out (e.g. inside CI that already ran `npm run build`).
if [[ ! -f "${CLI_ENTRY}" && "${SYNTH_SHIM_NO_BUILD:-0}" != "1" ]]; then
  echo "scripts/synth: dist/cli/synth.js not found; running 'npm run build'…" >&2
  (cd "${REPO_ROOT}" && npm run build >&2)
fi

if [[ ! -f "${CLI_ENTRY}" ]]; then
  echo "scripts/synth: ${CLI_ENTRY} is missing. Run 'npm run build' first." >&2
  exit 1
fi

exec node "${CLI_ENTRY}" "$@"
