# =============================================================================
# Operating System
# =============================================================================

.DS_Store
Thumbs.db

# =============================================================================
# Node
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# Build
# =============================================================================

dist/
coverage/
*.tsbuildinfo

# =============================================================================
# Runtime
# =============================================================================

# SYNTH artifacts by class. One classification, one place: E3 moves this table
# into src/state/artifact-policy.ts and makes CI check that the index agrees
# with it. Do not hand-edit one half of the table.
#
# derived projections (never committed)
.synth/ai/
.synth/context.json
.synth/discovery/
# cache + legacy (never committed)
.synth/cache/
.synth/anchor/
.synth/worktrees/
.synth/data/cli-errors.jsonl
.synth/data/event-log.jsonl
.synth/data/dependency-records-cache.json
# durable replay source stays tracked: chunked event stream + canonical state
!.synth/data/event-stream/
!.synth/data/canonical-state.json
# inputs stay tracked: mission/expedition drafts and their integrity records
# (the .synth/data/drafts/ and *.integrity.json rules were removed here — they
#  hid load-bearing planning inputs from every other clone; audit D6)
data-test/
data-test-alignment/
data-test-proposal-evaluation/

# =============================================================================
# Environment
# =============================================================================

.env
.env.*
!.env.example

# =============================================================================
# Local tooling config
# =============================================================================

# opencode project config is machine-local and can embed provider API keys.
opencode.json
opencode.jsonc

# agent session notes are machine-local and not part of the governance snapshot.
.agents/

# =============================================================================
# IDE
# =============================================================================

.vscode/
.idea/

# =============================================================================
# Logs
# =============================================================================

logs/
*.log

# =============================================================================
# Temporary
# =============================================================================

/tmp/
/temp/

# =============================================================================
# Cache
# =============================================================================

.cache/

# =============================================================================
# Generated Documentation
# =============================================================================

# Derived documentation projections are generated by `npm run docs:generate`.
# They are intentionally excluded from version control to avoid merge conflicts
# caused by timestamp/hash churn (see EXP-GUARD-002). The docs/generated/
# directory itself is kept with a .gitkeep file so the output target exists on
# a fresh clone.
docs/generated/*.md
examples/*/docs-generated/

# =============================================================================
# Mac
# =============================================================================

.AppleDouble
.LSOverride

# =============================================================================
# Ignore local test artifacts
# =============================================================================

*.seed
*.pid

# npm pack artifacts
*.tgz
